# Copy to .env and fill in. Placeholder values only in this file, never real ones.
# In Vercel, set the same variables in the api project (except PORT).

# --- Required ---
# Supabase transaction pooler (port 6543, ?pgbouncer=true), used by the app at runtime.
# Local Postgres from docker-compose.yml: postgresql://openslot:openslot@localhost:5432/openslot
DATABASE_URL=
# Supabase session pooler (port 5432), used by the Prisma CLI for migrations and seeding.
# Local Postgres: same as DATABASE_URL.
DIRECT_URL=
# Exact web origin(s) allowed by CORS, comma-separated, e.g. https://openslot.vercel.app
# Required in production; locally it defaults to http://localhost:5173.
CORS_ORIGIN=

# --- Local only ---
# Port the API listens on (default 3000). Vercel sets it; don't add it there.
PORT=

# --- Optional: Google Calendar free/busy check (off when any of the three is empty) ---
# Calendar to check, shared with the service account as "See only free/busy"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=openslot@your-project.iam.gserviceaccount.com
# Service account private key; literal \n is fine (e.g. on Vercel)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# --- Optional: Gemini booking messages (off when either is empty) ---
# API key from Google AI Studio (free tier, no billing account linked)
GEMINI_API_KEY=
# Model code without the "models/" prefix, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=
