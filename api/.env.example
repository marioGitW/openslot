# Supabase transaction pooler (port 6543, ?pgbouncer=true&connection_limit=1), used by the app at runtime
DATABASE_URL=
# Supabase session pooler (port 5432), used by the Prisma CLI for migrations
DIRECT_URL=
# Port the API listens on (default 3000)
PORT=
# Allowed frontend origin for CORS (default http://localhost:5173)
CORS_ORIGIN=
