# Supabase transaction pooler (port 6543, ?pgbouncer=true&connection_limit=1), used by the app at runtime
DATABASE_URL=
# Supabase session pooler (port 5432), used by the Prisma CLI for migrations
DIRECT_URL=
# Port the API listens on (default 3000)
PORT=
# Allowed frontend origin for CORS (default http://localhost:5173)
CORS_ORIGIN=
# Google Calendar free/busy check (optional; the feature is off when any of these is empty)
# Calendar to check, shared with the service account as "See only free/busy"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=openslot@your-project.iam.gserviceaccount.com
# Service account private key; literal \n is fine (e.g. on Vercel)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
